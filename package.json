{
  "name": "vellor",
  "version": "0.1.0",
  "private": true,
  "description": "Vellor — e-commerce de relógios de luxo e perfumes de nicho (monorepo)",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter \"./apps/*\" dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @vellor/web e2e",
    "db:generate": "pnpm --filter @vellor/api db:generate",
    "db:migrate": "pnpm --filter @vellor/api db:migrate",
    "db:seed": "pnpm --filter @vellor/api db:seed",
    "openapi": "pnpm --filter @vellor/api openapi:emit"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "prettier": "^3.6.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.0"
  }
}

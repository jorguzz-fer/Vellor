# ==============================================================================
# Vellor — variáveis de ambiente
# Copie para .env (nunca commite o .env). Em produção use o cofre de segredos
# do servidor ou o arquivo .env do Docker Compose com permissão 600.
# ==============================================================================

# --- Geral --------------------------------------------------------------------
NODE_ENV=development
PORT=3001
LOG_LEVEL=info
# URL pública da loja (usada em e-mails, redirecionamentos e verificação de origem)
APP_URL=http://localhost:3000
# URL pública da API, se for diferente da loja (no Docker/Caddy é a mesma origem)
# API_PUBLIC_URL=https://loja.exemplo.com.br
# Origens extras permitidas (separadas por vírgula)
# ALLOWED_ORIGINS=https://admin.exemplo.com.br
# Atrás do Caddy/Traefik, deixe true para o IP do cliente ser reconhecido
# TRUST_PROXY=true

# --- Banco de dados (PostgreSQL 17) -------------------------------------------
DATABASE_URL=postgres://vellor:vellor@localhost:5432/vellor_dev
# Aplica as migrations pendentes ao iniciar a API (recomendado em produção)
RUN_MIGRATIONS=false
# Usados pelo docker-compose para criar o banco
POSTGRES_USER=vellor
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=vellor

# --- Segurança ----------------------------------------------------------------
# Mínimo 32 caracteres. Gere com: openssl rand -base64 48
APP_ENCRYPTION_KEY=
SESSION_TTL_DAYS=30
ADMIN_SESSION_TTL_HOURS=12
# COOKIE_SECURE=true
# COOKIE_DOMAIN=.exemplo.com.br

# --- Primeiro administrador (usado pelo seed) ---------------------------------
ADMIN_EMAIL=admin@vellor.local
ADMIN_PASSWORD=TroqueEstaSenha#2026
ADMIN_NAME=Administrador

# --- Armazenamento de imagens --------------------------------------------------
# local: disco (volume Docker) servido em /uploads. s3: R2/S3/MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=vellor
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_PUBLIC_URL=https://cdn.exemplo.com.br
# S3_FORCE_PATH_STYLE=true

# --- Asaas (cobrança) ----------------------------------------------------------
# Sem ASAAS_API_KEY a API roda em modo simulado (pagamentos fictícios, só para dev/teste).
# ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Token configurado no painel do Asaas em Integrações > Webhooks (cabeçalho asaas-access-token)
# ASAAS_WEBHOOK_TOKEN=
# Em produção, exige ASAAS_API_KEY a menos que PAYMENTS_MOCK=true seja explícito
PAYMENTS_MOCK=false

# --- Correios (frete com seguro) ----------------------------------------------
# API oficial (https://cws.correios.com.br) exige contrato e cartão de postagem.
# Sem credenciais, o frete usa a tabela de contingência configurável no Admin.
# CORREIOS_USER=
# CORREIOS_ACCESS_CODE=
# CORREIOS_POSTAGE_CARD=
CORREIOS_API_URL=https://api.correios.com.br

# --- E-mail (SMTP) -------------------------------------------------------------
# Sem SMTP_HOST os e-mails são apenas registrados no log (dev). Em dev com Docker, use o Mailpit.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
MAIL_FROM="Vellor <no-reply@vellor.com.br>"

# --- Observabilidade -----------------------------------------------------------
# SENTRY_DSN=
# Protege GET /metrics (Authorization: Bearer <token>)
# METRICS_TOKEN=
OUTBOX_POLL_MS=5000
# Documentação OpenAPI em /api/docs (padrão: ligada fora de produção)
# SWAGGER_ENABLED=false

# --- Web (build do Vite) -------------------------------------------------------
# Em dev, para onde o Vite envia /api e /uploads
VITE_API_PROXY=http://localhost:3001

# --- Deploy (Caddy) ------------------------------------------------------------
# Domínio público; o Caddy emite o certificado TLS automaticamente
DOMAIN=localhost
ACME_EMAIL=admin@exemplo.com.br
